  "description": "Backend API for Suniti Construction CRM built with Node.js, Express, Prisma ORM, and Supabase PostgreSQL",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
